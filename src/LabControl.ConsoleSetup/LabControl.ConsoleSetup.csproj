<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LabControl.ConsoleSetup</RootNamespace>
    <AssemblyName>LabControl.ConsoleSetup</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- asInvoker, never requireAdministrator: installing the console is a per-user
         operation (D-59 item 1). Only the firewall switch asks for elevation, at the
         point of use. -->
    <ConsoleSetupManifestSource>$(MSBuildThisFileDirectory)app.manifest</ConsoleSetupManifestSource>
    <ApplicationManifest>$(BaseIntermediateOutputPath)LabControl.ConsoleSetup.manifest</ApplicationManifest>
    <ApplicationIcon>../LabControl.Console/Assets/labcontrol.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Written by tools/package-windows.sh: the published win-x64 console, zipped.
         The project builds without it so `dotnet build` works on any machine; an
         executable built that way refuses to install and says why. -->
    <ConsolePayloadZip>$(MSBuildThisFileDirectory)..\..\artifacts\package\windows\console-payload.zip</ConsolePayloadZip>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ConsolePayloadZip)')">
    <EmbeddedResource Include="$(ConsolePayloadZip)" LogicalName="LabControl.ConsoleSetup.Payload.zip" />
  </ItemGroup>

  <!-- The manifest Windows reads carries the build's own version, not a number frozen in a
       checked-in file: an Installed-apps entry that says 0.1.4 and a file whose manifest says
       1.0.0.0 is exactly the kind of disagreement that wastes an afternoon on a lab PC.
       $(AssemblyVersion) is only computed later, by GetAssemblyVersion, so this normally reads
       $(VersionPrefix) from Directory.Build.props — the one place the repository sets a
       version — and pads it, because assemblyIdentity takes exactly four components. -->
  <Target Name="StampSetupManifestVersion" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_SetupManifestVersion>$(AssemblyVersion)</_SetupManifestVersion>
      <_SetupManifestVersion Condition="'$(_SetupManifestVersion)' == ''">$(VersionPrefix)</_SetupManifestVersion>
      <_SetupManifestVersion Condition="'$(_SetupManifestVersion)' == ''">0.0.0</_SetupManifestVersion>
      <_SetupManifestVersion Condition="$([System.Version]::Parse('$(_SetupManifestVersion)').Build) &lt; 0">$(_SetupManifestVersion).0</_SetupManifestVersion>
      <_SetupManifestVersion Condition="$([System.Version]::Parse('$(_SetupManifestVersion)').Revision) &lt; 0">$(_SetupManifestVersion).0</_SetupManifestVersion>
      <_SetupManifestText>$([System.IO.File]::ReadAllText('$(ConsoleSetupManifestSource)').Replace('version="0.0.0.0"', 'version="$(_SetupManifestVersion)"'))</_SetupManifestText>
    </PropertyGroup>
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <WriteLinesToFile File="$(ApplicationManifest)" Lines="$(_SetupManifestText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <ProjectReference Include="..\LabControl.Shared\LabControl.Shared.csproj" />
  </ItemGroup>

</Project>
