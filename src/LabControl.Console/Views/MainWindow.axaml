<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LabControl.Console.Localization"
        xmlns:vm="clr-namespace:LabControl.Console.ViewModels"
        xmlns:views="clr-namespace:LabControl.Console.Views"
        x:Class="LabControl.Console.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Icon="avares://LabControl.Console/Assets/labcontrol.ico"
        Width="1100" Height="720"
        MinWidth="720" MinHeight="480">

  <Window.Styles>
    <Style Selector="Border.banner">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="Border.banner.warning">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="IndianRed" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Banners: other teacher machine, renewals, backup, unlocked key (ARCHITECTURE §3.7.2, §3.8, §4). -->
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Banners}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:BannerViewModel">
          <Border Classes="banner" Classes.warning="{Binding IsWarning}">
            <DockPanel>
              <Button DockPanel.Dock="Right"
                      Content="{Binding ActionLabel}"
                      IsVisible="{Binding HasAction}"
                      Click="OnBannerAction"
                      Margin="12,0,0,0" />
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Toolbar: actions apply to the selection (ARCHITECTURE §8). -->
    <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
        <!-- The lab chip (M5 §5): which lab this console drives, with what access, and the way out. -->
        <Button Content="{loc:Localize Main.Disconnect}" Command="{Binding DisconnectCommand}" IsEnabled="{Binding !IsDetached}" />
        <TextBlock Text="{Binding LabChip}" VerticalAlignment="Center" FontWeight="SemiBold" />
        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="4,0" />
        <!-- Actions wait for a connected session: not while the cached mosaic is still connecting, never once the lab was left. -->
        <!-- A wrap panel, not a stack: the actions grew past one line on a laptop (M6), and none may be cut off. -->
        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsEnabled="{Binding IsToolbarEnabled}">
        <Button Content="{loc:Localize Action.Wake}" Command="{Binding WakeCommand}" />
        <Button Content="{loc:Localize Action.Shutdown}" Command="{Binding ShutdownCommand}" />
        <Button Content="{loc:Localize Action.Reboot}" Command="{Binding RebootCommand}" />
        <Button Content="{loc:Localize Action.Logoff}" Command="{Binding LogoffCommand}" />
        <Button Content="{loc:Localize Action.SendFiles}" Command="{Binding SendFilesCommand}" />
        <!-- Collected work and profile reset (M6 portion 5, D-77, D-78): the selection; each PC answers in the jobs panel. -->
        <Button Content="{loc:Localize Action.CollectFiles}" Command="{Binding CollectFilesCommand}" />
        <Button Content="{loc:Localize Action.ResetProfile}" Command="{Binding ResetProfileCommand}" />
        <!-- Lock (M6 portion 1, D-70): the selection, or the whole lab; the tile badge follows what each PC reports. -->
        <Button Content="{loc:Localize Action.LockScreens}" Command="{Binding LockScreensCommand}" />
        <Button Content="{loc:Localize Action.UnlockScreens}" Command="{Binding UnlockScreensCommand}" />
        <Button Content="{loc:Localize Action.LockAll}" Command="{Binding LockAllScreensCommand}" />
        <Button Content="{loc:Localize Action.UnlockAll}" Command="{Binding UnlockAllScreensCommand}" />
        <!-- Internet (M6 portion 3, D-73): the selection, or the whole lab; the tile badge follows what each PC reports. -->
        <Button Content="{loc:Localize Action.Internet}" Command="{Binding InternetCommand}" />
        <Button Content="{loc:Localize Action.InternetForAll}" Command="{Binding InternetForAllCommand}" />
        <!-- Exam (M6 portion 4, D-75): the selection, or the whole lab; extend and end act on the PCs that report one. -->
        <Button Content="{loc:Localize Action.Exam}" Command="{Binding ExamCommand}" />
        <Button Content="{loc:Localize Action.ExamForAll}" Command="{Binding ExamForAllCommand}" />
        <Button Content="{loc:Localize Action.ExtendExam}" Command="{Binding ExtendExamCommand}" IsVisible="{Binding AnyInExam}" />
        <Button Content="{loc:Localize Action.EndExam}" Command="{Binding EndExamCommand}" IsVisible="{Binding AnyInExam}" />
        <!-- Broadcast (M6 portion 2, D-71): this console's screen on the selection, or the whole lab. -->
        <Button Content="{loc:Localize Action.ShowScreen}" Command="{Binding ShowScreenCommand}" />
        <Button Content="{loc:Localize Action.ShowScreenToAll}" Command="{Binding ShowScreenToAllCommand}" />
        <Button Content="{loc:Localize Action.StopShowingScreen}" Command="{Binding StopShowingScreenCommand}" IsVisible="{Binding IsBroadcasting}" />
        <Button Content="{loc:Localize Action.PushBuild}" Command="{Binding PushBuildCommand}" IsVisible="{Binding IsAdministrator}" />
        <Button Content="{loc:Localize Action.RemoveSelected}" Command="{Binding RemoveSelectedCommand}" />
        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="4,0" />
        <Button Content="{loc:Localize Action.SelectAll}" Command="{Binding SelectAllCommand}" />
        <Button Content="{loc:Localize Action.ClearSelection}" Command="{Binding ClearSelectionCommand}" />
        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="4,0" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAdministrator}">
          <Button Content="{loc:Localize Action.EnrolPcs}" Command="{Binding UnlockCommand}" IsVisible="{Binding !IsUnlocked}" />
          <Button Content="{loc:Localize Key.Lock}" Command="{Binding LockCommand}" IsVisible="{Binding IsUnlocked}" />
        </StackPanel>
        <!-- Teacher access (M5, D-56 item 5): the administrator-only actions are hidden, and one line says why. -->
        <TextBlock Text="{Binding AccessHint}" IsVisible="{Binding !IsAdministrator}" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        </WrapPanel>
        <TextBlock Text="{Binding SelectedCount, StringFormat={loc:Localize Main.SelectedFormat}}"
                   VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0" />
      </WrapPanel>
    </Border>

    <!-- Status bar. -->
    <Border DockPanel.Dock="Bottom" Padding="14,6"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding KeyStatus}" Opacity="0.7" FontSize="12" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding BroadcastStatus}" IsVisible="{Binding IsBroadcasting}" FontSize="12" FontWeight="SemiBold" Foreground="#1F5FAF" Margin="0,0,16,0" />
        <TextBlock Text="{Binding StatusLine}" Opacity="0.7" FontSize="12" />
      </DockPanel>
    </Border>

    <TabControl Padding="0">
      <TabItem Header="{loc:Localize Tab.Lab}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="10,8" DataContext="{Binding Scripts}" x:DataType="vm:ScriptsViewModel">
            <StackPanel Spacing="4">
              <WrapPanel>
                <ComboBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding Selected}" Width="260" Margin="0,0,8,0">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScriptRowViewModel">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="•" IsVisible="{Binding IsDirty}" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{Binding RunLabel}" Command="{Binding RunCommand}" />
              </WrapPanel>
              <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.7" />
              <TextBlock Text="{loc:Localize Scripts.QuickHint}" IsVisible="{Binding IsDirty}" />
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <views:LabView />
        </DockPanel>
      </TabItem>
      <TabItem Header="{loc:Localize Tab.Scripts}">
        <views:ScriptsView DataContext="{Binding Scripts}" />
      </TabItem>
      <TabItem Header="{loc:Localize Tab.Jobs}">
        <views:JobsView />
      </TabItem>
      <TabItem Header="{loc:Localize Tab.Events}">
        <views:EventsView />
      </TabItem>
      <TabItem Header="{loc:Localize Tab.Settings}">
        <views:SettingsView DataContext="{Binding Settings}" />
      </TabItem>
    </TabControl>

  </DockPanel>

</Window>
