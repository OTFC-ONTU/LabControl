<Project Sdk="Microsoft.NET.Sdk">

  <!-- Documentation mirror generator: docs/*.md -> docs/html/*.html.
       Deliberately outside LabControl.sln: it is a build tool, not part of the product. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LabControl.DocsBuild</RootNamespace>
    <AssemblyName>DocsBuild</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
  </ItemGroup>

</Project>
