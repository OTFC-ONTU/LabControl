<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LabControl.Console.Localization"
             xmlns:vm="clr-namespace:LabControl.Console.ViewModels"
             x:Class="LabControl.Console.Views.PackagesView"
             x:DataType="vm:PackagesViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.k">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="300,1,*">

    <!-- The catalog (D-07, D-88): name, version and kind, and whether the installer is on this computer. -->
    <DockPanel Grid.Column="0" Margin="8,8,0,8">
      <Button DockPanel.Dock="Top" Classes="accent" Content="{loc:Localize Packages.Add}" Command="{Binding AddCommand}" Margin="0,0,0,8" />
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding LastChanged}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />
      <Panel>
        <TextBlock Text="{loc:Localize Packages.Empty}" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" Opacity="0.7" Margin="4" />
        <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding Selected}" IsVisible="{Binding !IsEmpty}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PackageRowViewModel">
              <StackPanel Margin="0,2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Details}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="DarkOrange" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>
    </DockPanel>

    <Rectangle Grid.Column="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />

    <!-- The selected entry: what the teacher may correct, then what was recorded when it was added. -->
    <ScrollViewer Grid.Column="2">
      <StackPanel Margin="12,8,12,8" Spacing="8">
        <TextBlock Text="{Binding StateLine}" TextWrapping="Wrap" FontWeight="SemiBold" />
        <StackPanel Spacing="8" IsEnabled="{Binding HasEntry}">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Grid.Row="0" Classes="k" Text="{loc:Localize Packages.Name}" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" MaxLength="80" />
            <TextBlock Grid.Row="1" Classes="k" Text="{loc:Localize Packages.Version}" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Version}" MaxLength="64" HorizontalAlignment="Left" MinWidth="160" />
            <TextBlock Grid.Row="2" Classes="k" Text="{loc:Localize Packages.Silent}" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Silent}" MaxLength="1024" FontFamily="Menlo, Consolas, monospace" />
            <TextBlock Grid.Row="3" Classes="k" Text="{loc:Localize Packages.DetectShort}" />
            <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="{Binding DetectIndex}" MinWidth="260">
              <ComboBoxItem Content="{loc:Localize Packages.DetectByName}" />
              <ComboBoxItem Content="{loc:Localize Packages.DetectByPath}" />
            </ComboBox>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DetectValue}" MaxLength="260" />
            <TextBlock Grid.Row="5" Classes="k" Text="{loc:Localize Packages.Timeout}" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TimeoutText}" MaxLength="3" Width="80" HorizontalAlignment="Left" />
          </Grid>
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="{loc:Localize Packages.Save}" Command="{Binding SaveCommand}" />
            <Button Content="{loc:Localize Packages.Revert}" Command="{Binding RevertCommand}" />
            <Button Content="{loc:Localize Packages.Delete}" Command="{Binding DeleteCommand}" />
          </WrapPanel>

          <!-- On the PCs (M7 portion 4, D-89): the test install on the selection, then the rest. -->
          <Rectangle Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4" />
          <TextBlock Text="{loc:Localize Packages.OnThePcs}" FontWeight="SemiBold" />
          <TextBlock Text="{loc:Localize Packages.TestHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Classes="accent" Content="{Binding InstallSelectedLabel}" Command="{Binding InstallSelectedCommand}" />
            <Button Content="{loc:Localize Packages.InstallAllMissing}" Command="{Binding InstallAllMissingCommand}" />
            <Button Content="{loc:Localize Packages.Check}" Command="{Binding CheckPcsCommand}" />
          </WrapPanel>
          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Pcs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PackagePcRow">
                <Grid ColumnDefinitions="64,170,*" Margin="0,1">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="DarkOrange" IsVisible="{Binding IsProblem}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding StateText}" IsVisible="{Binding !IsProblem}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{Binding Facts}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />
          <TextBlock Text="{loc:Localize Packages.SystemNote}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.7" />
        <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>

</UserControl>
