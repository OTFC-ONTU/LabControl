<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LabControl.Console.Localization"
        xmlns:vm="clr-namespace:LabControl.Console.ViewModels"
        x:Class="LabControl.Console.Views.LabChooserWindow"
        x:DataType="vm:LabChooserViewModel"
        Title="{loc:Localize Chooser.Title}"
        Icon="avares://LabControl.Console/Assets/labcontrol.ico"
        Width="720" Height="520"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.p">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="IndianRed" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Border.row.highlighted">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
    </Style>
    <Style Selector="Border.row.active">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="24">

    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
      <TextBlock Classes="h" Text="{loc:Localize Chooser.Heading}" />
      <TextBlock Classes="p" Text="{loc:Localize Chooser.Hint}" />
    </StackPanel>

    <!-- Buttons: Open on Enter, Quit on Escape. -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button Classes="accent" Content="{loc:Localize Chooser.Open}" Command="{Binding OpenCommand}" IsDefault="True" Padding="16,8" />
      <Button Content="{loc:Localize Chooser.Retry}" Command="{Binding RetryCommand}" IsVisible="{Binding HasFailure}" />
      <Button Content="{loc:Localize Chooser.AddLabs}" Command="{Binding AddLabsCommand}" />
      <Button Content="{loc:Localize Chooser.Create}" Command="{Binding CreateLabCommand}" />
      <Button Content="{loc:Localize Chooser.Remove}" Command="{Binding RemoveCommand}" />
      <Button Content="{loc:Localize Common.Quit}" Command="{Binding QuitCommand}" IsCancel="True" HorizontalAlignment="Right" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="4">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="p" Text="{loc:Localize Chooser.DropHint}" FontSize="12" />
    </StackPanel>

    <Panel>
      <TextBlock Classes="p" Text="{loc:Localize Chooser.Empty}" IsVisible="{Binding !HasLabs}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" />
      <ListBox x:Name="LabList" ItemsSource="{Binding Labs}" SelectedItem="{Binding Selected}" IsVisible="{Binding HasLabs}"
               DoubleTapped="OnRowDoubleTapped" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LabRowViewModel">
            <Border Classes="row" Classes.highlighted="{Binding IsHighlighted}" Classes.active="{Binding IsActive}">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Details}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>

  </DockPanel>

</Window>
