<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LabControl.Console</RootNamespace>
    <AssemblyName>LabControl.Console</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets/labcontrol.ico</ApplicationIcon>
    <!-- The console is localized (English now, Ukrainian in M6), so globalization stays on. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by tools/make-icon.py; the .ico is also the window icon on every OS. -->
    <AvaloniaResource Include="Assets/labcontrol.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The seed of the script library (D-31 item 4, D-38): imported into scripts.json on the first run. -->
    <EmbeddedResource Include="../../scripts/library/*.ps1;../../scripts/library/*.cmd" LogicalName="LabControl.Console.Seed.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabControl.Shared\LabControl.Shared.csproj" />
  </ItemGroup>

</Project>
