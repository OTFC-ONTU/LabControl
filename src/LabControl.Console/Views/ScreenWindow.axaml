<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LabControl.Console.ViewModels"
        xmlns:views="clr-namespace:LabControl.Console.Views"
        xmlns:loc="clr-namespace:LabControl.Console.Localization"
        x:Class="LabControl.Console.Views.ScreenWindow"
        x:DataType="vm:ScreenViewModel"
        Title="{Binding Title}"
        Icon="avares://LabControl.Console/Assets/labcontrol.ico"
        Width="1280" Height="820"
        MinWidth="480" MinHeight="320">

  <DockPanel>
    <!-- Control toggle and the two keys the teacher's own keyboard cannot send (portion 3, D-36). -->
    <Border DockPanel.Dock="Top" Padding="8,6"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ToggleButton x:Name="ControlToggle" Content="{loc:Localize Screen.Control}"
                      IsChecked="{Binding IsControlling, Mode=TwoWay}" IsEnabled="{Binding CanControl}" />
        <Button Content="{loc:Localize Screen.CtrlAltDel}" Command="{Binding SendCtrlAltDelCommand}" />
        <Button Content="{loc:Localize Screen.WindowsKey}" Command="{Binding SendWindowsKeyCommand}" />
        <TextBlock Text="{loc:Localize Screen.QualityLabel}" VerticalAlignment="Center" Margin="12,0,0,0" />
        <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality, Mode=TwoWay}" MinWidth="110" />
        <TextBlock Text="{Binding ControlHint}" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="8,0,0,0" />
      </StackPanel>
    </Border>

    <!-- The numbers under the picture: resolution, rate, bandwidth — or why there is no picture or no control. -->
    <Border DockPanel.Dock="Bottom" Padding="12,6"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}">
      <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.8" />
    </Border>

    <Panel Background="Black">
      <views:ScreenView x:Name="Picture" Image="{Binding Image}" Frame="{Binding FrameVersion}" IsStale="{Binding IsStale}"
                        Focusable="True" />
    </Panel>
  </DockPanel>

</Window>
