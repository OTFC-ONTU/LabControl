  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LabControl.Shared</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
