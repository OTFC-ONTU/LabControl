<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>agent</AssemblyName>
    <DefineConstants Condition="'$(FixtureMode)' == 'crash'">$(DefineConstants);BROKEN_CRASH</DefineConstants>
    <DefineConstants Condition="'$(FixtureMode)' == 'no-link'">$(DefineConstants);BROKEN_NO_LINK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <ProjectReference Include="../../../src/LabControl.Shared/LabControl.Shared.csproj" />
  </ItemGroup>
  <Target Name="RequireFixtureMode" BeforeTargets="CoreCompile">
    <Error Condition="'$(FixtureMode)' != 'crash' and '$(FixtureMode)' != 'no-link'" Text="Choose FixtureMode=crash or FixtureMode=no-link for this disposable test service." />
  </Target>
</Project>
